# Copy to server/.env and fill in. server/.env is gitignored — never commit it.
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Supabase dashboard → Project Settings → API Keys
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Supabase → Connect. Session pooler (:5432), or transaction pooler (:6543) with DB_POOL_MODE=transaction.
# Percent-encode @ # / : % in the password (%40 %23 %2F %3A %25).
DATABASE_URL=
# DB_POOL_MODE=transaction

# console.anthropic.com → API Keys. Optional: without it AI routes answer 503 and everything else works.
ANTHROPIC_API_KEY=

REDIS_URL=redis://localhost:6379/0
# MAX_IN_FLIGHT=256
