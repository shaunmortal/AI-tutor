# Copy to server/.env and fill in. server/.env is gitignored — never commit it.
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Supabase dashboard → Project Settings → API Keys
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Supabase → Connect. Session pooler (:5432), or transaction pooler (:6543) with DB_POOL_MODE=transaction.
# Percent-encode @ # / : % in the password (%40 %23 %2F %3A %25).
DATABASE_URL=
# DB_POOL_MODE=transaction

# AI provider: claude (default) or gemini. Without the chosen provider's key, AI routes answer
# 503 and everything else works.
AI_PROVIDER=claude
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# aistudio.google.com → Get API key (free tier available)
GEMINI_API_KEY=
# Optional per-task models. Claude defaults: opus-5-5 / sonnet-5-5 (e.g. claude-haiku-5-5 is
# ~20x cheaper for STANDARD). Gemini defaults: gemini-3.5-flash / gemini-3.5-flash-lite.
# AI_MODEL_HIGH=
# AI_MODEL_STANDARD=

REDIS_URL=redis://localhost:6379/0
# MAX_IN_FLIGHT=256
